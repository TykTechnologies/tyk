  "type": "object",
  "properties": {
    "upstreams": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "properties": {
          "apiId": {
            "type": "string"
          },
          "alias": {
            "type": "string"
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "apiId",
          "alias"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "upstreams"
  ],
  "additionalProperties": false
}
